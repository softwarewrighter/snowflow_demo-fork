#!/usr/bin/env xetal
## A finite continuous snowfield with rounded ice formations. The host reads mesh! as typed array data.
## Tick advances the ridge, down changes its height, and a key resets it.

u:t_errain := { a ->
  k := (r_ange 1089) - 1
  x := (f_loat (k d_iv 33)) - 16.0
  z := (f_loat (k m_od 33)) - 16.0
  hill := (2.4 / (1.0 + (0.025 * ((x + 7.0) * (x + 7.0))) + (0.018 * z * z)))
  ice := 4.0 / (1.0 + (1.4 * ((x - 4.0) * (x - 4.0))) + (0.8 * ((z + 3.0) * (z + 3.0))))
  rock := 3.2 / (1.0 + (0.9 * ((x + 4.0) * (x + 4.0))) + (1.5 * ((z - 1.0) * (z - 1.0))))
  y := hill + ice + rock + (a * (1.0 + (0.03 * x * z)))
  points := 2 1 t_ranspose (3 1089 r_eshape x c_at y c_at z)
  cell := (r_ange 1024) - 1
  base := ((cell d_iv 32) * 33) + (cell m_od 32)
  ids := 1 + r_avel base '+ t_able 0 1 33 1 34 33
  2048 3 3 r_eshape ids s_elect points
}

phase! := 0.0
boost! := 0.0
mesh! := u:t_errain 0.18
u:w_atch := { @ -> mesh! }
'u:w_atch

u:h_eight := { @ ->
  f := phase! - f_loat f_loor phase!
  0.18 + (0.18 * boost!) + (0.12 * (1.0 - a_bs ((2.0 * f) - 1.0)))
}
u:a_dvance := { e ->
  phase! := phase! + f_irst []E_AT e
  mesh! := u:t_errain u:h_eight @
  @
}
u:t_ap := { @ ->
  boost! := 1.0 - boost!
  mesh! := u:t_errain u:h_eight @
  @
}
u:r_eset := { @ ->
  phase! := 0.0
  boost! := 0.0
  mesh! := u:t_errain 0.18
  @
}
u:c_hange := { e ->
  kind := []E_KIND e
  kind m_atch "tick" ? u:a_dvance e
  kind m_atch "down" ? u:t_ap @
  kind m_atch "key" ? u:r_eset @
  @
}
u:l_oop := { @ ->
  e := []E_VENT @
  ([]E_KIND e) m_atch "end" ? @
  changed := u:c_hange e
  u:l_oop @
}
u:l_oop @
