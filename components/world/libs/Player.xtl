## Player: immutable footfall state and durable sequenced sound commands.
## Reference: library-reference.html#player
"feet:" u_se< "Footsteps.xtl"
"sfx:" u_se< "SnowAudio.xtl"
l:s_tart := { point -> (feet:s_tart point, 0.0, 0, sfx:s_ilent @) }
l:c_lear := { point (_, _, seq, _) -> (feet:s_tart point, 0.0, seq, sfx:s_ilent @) }
l:t_ick := { dt (foot, impact, seq, sound) -> (dt feet:t_ick foot, impact, seq, sound) }
l:p_ose := { (position, aim, grounded, impact) state ->
  (foot, previous, seq, last) := state
  point := 1 3 s_elect position
  hit := { @ -> previous > 0.0 ? 0.0; impact } @
  (next, event) := (point, f_irst aim, grounded, hit) feet:u_pdate foot
  sound := sfx:c_ommand (event, feet:c_ount next)
  (f_irst sound) = 0.0 ? (next, impact, seq, last)
  (next, impact, seq + 1, sound)
}
l:p_rints := { (foot, _, _, _) -> feet:v_iew foot }
l:a_udio := { (_, _, seq, sound) -> (seq, sound) }
l:s_tats := { (foot, _, _, _) -> (("steps", feet:c_ount foot), ("landings", feet:l_ands foot), ("wind", feet:w_ind foot)) }
