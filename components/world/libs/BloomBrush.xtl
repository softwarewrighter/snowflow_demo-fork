## BloomBrush: immutable latest-four radial crater/rim history and dirty bounds.
## Rows: [serial centerX centerZ]. Reference: library-reference.html#bloom-brush
"brush:" u_se< "TerrainBrush.xtl"
l:s_tart := { @ -> 0 3 r_eshape 0.0 }
l:r_egion := { row ->
  x := 2 s_elect row
  z := 3 s_elect row
  (x - 4.6) c_at (x + 4.6) c_at (z - 4.6) c_at (z + 4.6)
}
l:u_pdate := { row history ->
  n := f_irst s_hape history
  bounds := 1 4 r_eshape l:r_egion row
  n = 0 ? (1 3 r_eshape row, bounds)
  last := n s_elect history
  (f_irst row) = f_irst last ? ((-1 d_rop history) c_at 1 3 r_eshape row, bounds)
  n < 4 ? (history c_at 1 3 r_eshape row, bounds)
  ((1 d_rop history) c_at 1 3 r_eshape row, bounds c_at 1 4 r_eshape l:r_egion (1 s_elect history))
}
h:s_tamp := { (x, z) row ->
  dx := x - 2 s_elect row
  dz := z - 3 s_elect row
  radius := ((dx * dx) + (dz * dz)) ^ 0.5
  brush:r_adial (radius, 0.9, 0.6)
}
l:d_elta := { (x, z) history ->
  (f_irst s_hape history) = 0 ? 0.0 * x
  ((x, z) h:s_tamp (1 s_elect history)) + ((x, z) l:d_elta (1 d_rop history))
}
