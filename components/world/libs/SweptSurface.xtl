## SweptSurface: sweep a curled seven-sample section along an N-row spine.
## Spine columns: [x y z radialX radialZ height]. Output: triangle array.
## Reference: library-reference.html#swept-surface
l:s_heet := { spine ->
  n := f_irst s_hape spine
  k := (r_ange (n * 7)) - 1
  rows := (1 + (k d_iv 7)) s_elect spine
  columns := 2 1 t_ranspose rows
  t := (f_loat (k m_od 7)) / 6.0
  curl := (0.8 * s_in (3.1415926536 * t)) - (0.5 * t * t)
  x := (1 s_elect columns) + (curl * 4 s_elect columns)
  y := (2 s_elect columns) + ((s_in (1.5707963268 * t)) * 6 s_elect columns)
  z := (3 s_elect columns) + (curl * 5 s_elect columns)
  points := 2 1 t_ranspose ((3 c_at (n * 7)) r_eshape x c_at y c_at z)
  cells := (r_ange ((n - 1) * 6)) - 1
  base := ((cells d_iv 6) * 7) + (cells m_od 6)
  ids := 1 + r_avel base '+ t_able 0 1 7 1 8 7
  (((n - 1) * 12) c_at 3 3) r_eshape ids s_elect points
}
l:t_ube := { spine ->
  n := f_irst s_hape spine
  k := (r_ange (n * 17)) - 1
  rows := (1 + (k d_iv 17)) s_elect spine
  columns := 2 1 t_ranspose rows
  angle := (6.2831853072 * f_loat (k m_od 17)) / 16.0
  radius := 4 s_elect columns
  x := (1 s_elect columns) + (radius * c_os angle)
  y := 2 s_elect columns
  z := (3 s_elect columns) + (radius * s_in angle)
  points := 2 1 t_ranspose ((3 c_at (n * 17)) r_eshape x c_at y c_at z)
  cells := (r_ange ((n - 1) * 16)) - 1
  base := ((cells d_iv 16) * 17) + (cells m_od 16)
  ids := 1 + r_avel base '+ t_able 0 1 17 1 18 17
  (((n - 1) * 32) c_at 3 3) r_eshape ids s_elect points
}
