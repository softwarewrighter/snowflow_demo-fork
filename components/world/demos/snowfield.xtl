#!/usr/bin/env xetal
## Snow app: library-led immutable updates; Rust supplies pose facts and executes output.
## Click a library function in As rendered for API, source and backend references.
## Reference: library-reference.html
"snow:" u_se< "../libs/SnowTerrain.xtl"
"feet:" u_se< "../libs/Footsteps.xtl"
"sfx:" u_se< "../libs/SnowAudio.xtl"
"host:" u_se< "../libs/SnowHost.xtl"

# The one mutable binding publishes typed mesh, print and audio commands to the host.
frame! := (0 3 3 r_eshape 0.0, 0 6 r_eshape 0.0, sfx:s_ilent @, 0, 0, 0.3)
u:w_atch := { @ -> frame! }
'u:w_atch

u:s_tart := { @ -> ((0.0, 0.0), feet:s_tart 0.0 8.0, 0.0 8.0, snow:m_esh (0.0, 0.0)) }
u:i_dle := { state ->
  (_, foot, _, _) := state
  (state, feet:v_iew foot, sfx:s_ilent @)
}
u:c_hunk := { state e ->
  (chunk, foot, point, _) := state
  next := host:c_hunk e
  chunk m_atch next ? u:i_dle state
  u:i_dle (next, foot, point, snow:m_esh next)
}
u:p_ose := { (grounded, e) state ->
  (chunk, foot, point, mesh) := state
  (next, sound) := (host:p_ose (point, grounded, e)) feet:u_pdate foot
  ((chunk, next, point, mesh), feet:v_iew next, sfx:c_ommand (sound, feet:c_ount next))
}
u:f_rame := { state e ->
  (chunk, foot, point, mesh) := state
  kind := []E_KIND e
  kind m_atch "choose" ? state u:c_hunk e
  kind m_atch "move" ? u:i_dle (chunk, foot, []E_AT e, mesh)
  kind m_atch "down" ? (1, e) u:p_ose state
  kind m_atch "up" ? (0, e) u:p_ose state
  kind m_atch "tick" ? u:i_dle (chunk, (f_irst []E_AT e) feet:t_ick foot, point, mesh)
  kind m_atch "click" ? u:i_dle (chunk, feet:s_tart point, point, mesh)
  kind m_atch "key" ? u:i_dle u:s_tart @
  u:i_dle state
}
u:l_oop! := { (state, prints, sound) ->
  (_, foot, _, mesh) := state
  frame! := (mesh, prints, sound, feet:c_ount foot, feet:l_ands foot, feet:w_ind foot)
  e := host:n_ext! @
  ([]E_KIND e) m_atch "end" ? @
  u:l_oop! state u:f_rame e
}
u:l_oop! u:i_dle u:s_tart @
