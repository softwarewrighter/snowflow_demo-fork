#!/usr/bin/env xetal
## Streamed terrain host: immutable shared brush history, typed mesh and dirty bounds.
"snow:" u_se< "../libs/SnowTerrain.xtl"
"carve:" u_se< "../libs/SweepBrush.xtl"
"crater:" u_se< "../libs/BloomBrush.xtl"
"host:" u_se< "../libs/SnowHost.xtl"
initial := snow:m_esh (0.0, 0.0)
frame! := (initial, 0 4 r_eshape 0.0)
u:w_atch := { @ -> frame! }
'u:w_atch
h:r_egions := { history ->
  (f_irst s_hape history) = 0 ? 0 4 r_eshape 0.0
  (1 4 r_eshape carve:r_egion (1 s_elect history)) c_at h:r_egions (1 d_rop history)
}
h:c_raters := { history ->
  (f_irst s_hape history) = 0 ? 0 4 r_eshape 0.0
  (1 4 r_eshape crater:r_egion (1 s_elect history)) c_at h:c_raters (1 d_rop history)
}
u:u_pdate := { (state, mesh, _) event ->
  (chunk, history, blooms, point, params) := state
  kind := []E_KIND event
  at := []E_AT event
  empty := 0 4 r_eshape 0.0
  kind m_atch "move" ? ((chunk, history, blooms, at, params), mesh, empty)
  kind m_atch "down" ? ((chunk, history, blooms, point, at), mesh, empty)
  kind m_atch "up" ? { @ ->
    row := (f_irst at) c_at point c_at params
    (next, regions) := row carve:u_pdate history
    ((chunk, next, blooms, point, params), mesh, regions)
  } @
  kind m_atch "click" ? { @ ->
    row := (f_irst at) c_at point
    (next, regions) := row crater:u_pdate blooms
    ((chunk, history, next, point, params), mesh, regions)
  } @
  kind m_atch "key" ? ((chunk, carve:s_tart @, crater:s_tart @, point, params), mesh, (h:r_egions history) c_at h:c_raters blooms)
  kind m_atch "choose" ? { @ ->
    next := host:c_hunk event
    ((next, history, blooms, point, params), snow:c_arved (next, history, blooms), empty)
  } @
  (state, mesh, empty)
}
u:l_oop! := { publication ->
  e := host:n_ext! @
  ([]E_KIND e) m_atch "end" ? @
  next := publication u:u_pdate e
  (_, mesh, regions) := next
  frame! := (mesh, regions)
  u:l_oop! next
}
u:l_oop! (((0.0, 0.0), carve:s_tart @, crater:s_tart @, 0.0 0.0, 0.0 0.0), initial, 0 4 r_eshape 0.0)
